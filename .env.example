# ============================================================================
# VYBE — Environment configuration
# ============================================================================
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
#
# SECURITY:
#  - Only VITE_* variables are exposed to the browser bundle.
#  - Use ONLY the Supabase anon/public key here — NEVER the service-role key.
#  - Restrict the Google Maps browser key to your production domains.
#
# VYBE is a real-data application. Supabase is required for accounts and
# cloud data; Google Maps is optional because VYBE has an OSM/Leaflet fallback.
# ============================================================================

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL — password reset / OAuth redirect target
VITE_SITE_URL=http://localhost:5173

# Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
