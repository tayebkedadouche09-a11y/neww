# ============================================================================
# VYBE — Environment configuration
# ============================================================================
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
#
# SECURITY:
#  - Only VITE_* variables are exposed to the browser bundle.
#  - Use ONLY the Supabase anon/public key in VITE_SUPABASE_ANON_KEY.
#  - NEVER put a Supabase service-role key in any VITE_* variable.
#  - Restrict the Google Maps browser key to your production domains/APIs.
#  - Server-only secrets below must exist only in Vercel/server environment.
#
# VYBE is a real-data application. Supabase is required for accounts and
# cloud data; Google Maps is optional because VYBE has an OSM/Leaflet fallback.
# ============================================================================

# Browser-exposed Supabase project settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL — password reset / OAuth redirect target
VITE_SITE_URL=http://localhost:5173

# Browser Google Maps Platform configuration
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# ============================================================================
# SERVER-ONLY SECURITY SETTINGS — DO NOT prefix these with VITE_
# Configure these in Vercel Project Settings → Environment Variables.
# ============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_SERVER_API_KEY=

# AUTH HARDENING (configure in Supabase Dashboard → Auth → Password)
# Recommended production policy:
#  - minimum password length: 12+
#  - require lowercase + uppercase + number + symbol
#  - enable leaked-password protection when available on your plan
