# ============================================================================
# VYBE — Environment configuration
# ============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# IMPORTANT SECURITY NOTES:
#  - Only VITE_* variables are exposed to the browser bundle.
#  - Use ONLY the anon/public key here — NEVER the service-role key.
#    The service_role key bypasses Row Level Security and must stay server-side.
#  - The Google Maps API key is safe for browser use when restricted to
#    your domain(s) in Google Cloud Console.
# ============================================================================

# Supabase project (https://supabase.com/dashboard → Project Settings → API)
# Leave BOTH empty to run VYBE in local demo-data mode (no backend required).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL — used as the redirect target for password-reset / OAuth
# emails (Supabase Dashboard → Auth → URL Configuration must allow it).
VITE_SITE_URL=http://localhost:5173

# Google Maps Platform (https://console.cloud.google.com/google-apis/overview)
# Leave empty to use the built-in Leaflet map fallback.
# Required APIs: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=
# Optional: Google Maps Map ID for styled maps and AdvancedMarkerElement
# (https://console.cloud.google.com/maps-apis/studio/). Without a real Map ID
# the API emits a console warning but the map still renders.
VITE_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------------
# Demo Mode (OPTIONAL)
# ---------------------------------------------------------------------------
# When set to "true", the app ignores the Supabase backend and runs in local
# demo-data mode with bundled place data + localStorage persistence.
# Default: false (real backend is used when VITE_SUPABASE_* credentials are
# present).
VITE_DEMO_MODE=false

